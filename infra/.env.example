# Local test environment for the infra/docker-compose.yml stack.
#
# Usage (from infra/):
#   cp .env.example .env
#   docker compose up --build
#   → app at http://localhost (Caddy fronts web, and api under /api)
#
# Every value below is a throwaway dev default: fine for local testing,
# never for a real deployment. For a real deployment run ./generate-env.sh,
# which fills the same variables with random secrets.
#
# Local-testing caveats:
# - Emails (verification/reset/invitations) are caught by Mailpit — read
#   them at http://localhost:8025. Nothing leaves the machine.
# - DEV_SEED_USERS=true pre-creates verified logins (see the SMTP section
#   below), so you can sign in without touching the email flow at all.
# - Google OAuth values are dummies: the /auth/google/* flow will not
#   complete without real credentials (everything else works).

# Enables the dev-only services in docker-compose.yml (mailpit).
COMPOSE_PROFILES=dev

########################################
# Application
########################################

# Caddy listens on :80, so the stack is reachable at plain http://localhost.
PUBLIC_BASE_URL=http://localhost

# No TLS on http://localhost — Secure cookies would be dropped by some
# browsers. Leave unset (defaults to true) in real deployments.
SECURE_COOKIES=false

########################################
# PostgreSQL
########################################
# DB name (manage_our_home) and app user (mhome) are fixed in docker-compose.yml.

POSTGRES_PASSWORD=dev-postgres-password

# Password for the BYPASSRLS `admin_role` created at first postgres boot by
# postgres/init/01-admin-role.sh (superadmin endpoints, apps/api/README.md).
ADMIN_ROLE_PASSWORD=dev-admin-role-password

########################################
# Google OAuth
########################################

GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

########################################
# Encryption keys (pgp_sym_encrypt passphrases — any string works)
########################################

OAUTH_ENCRYPTION_KEY=dev-oauth-encryption-key
MESSAGE_ENCRYPTION_KEY=dev-message-encryption-key
CALENDAR_FEED_ENCRYPTION_KEY=dev-calendar-feed-encryption-key

########################################
# SMTP
########################################
# SMTP_FROM must parse as a mailbox or the API exits at startup.
#
# Dev setup: emails go to the Mailpit container (web UI at
# http://localhost:8025) over plaintext SMTP. SMTP_ALLOW_INSECURE only
# takes effect when it is exactly "true"; leave it unset in real
# deployments, where the API uses the TLS relay path with the credentials
# below (unused by Mailpit, but docker-compose.yml references them).

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ALLOW_INSECURE=true
SMTP_USERNAME=dev
SMTP_PASSWORD=dev
SMTP_FROM=no-reply@example.test

# Seeds pre-verified logins at API startup (idempotent):
#   alice.dev@example.test / devpassword  (owner of group "Foyer Dev")
#   bob.dev@example.test   / devpassword  (member)
# Never enable on a real deployment — the password is public knowledge.
DEV_SEED_USERS=true

########################################
# MinIO
########################################
# The `manage-our-home` bucket is created by the one-shot minio-init service.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=dev-minio-password
