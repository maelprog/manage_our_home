DATABASE_URL=postgres://mhome:mhome@localhost:5432/manage_our_home
# Required, no DATABASE_URL fallback (issue #105). Migrations are applied
# through this connection only, as a role that owns the tables and carries
# BYPASSRLS — on the NOSUPERUSER NOBYPASSRLS role the deployment note in
# README.md prescribes for DATABASE_URL, a migration's DML reads its source
# tables back empty and applies to nothing without saying so. The API
# refuses to start if this role doesn't bypass RLS.
MIGRATION_DATABASE_URL=postgres://migration_role:changeme@localhost:5432/manage_our_home
# BYPASSRLS role for the three /admin/* superadmin endpoints (Epic #8).
ADMIN_DATABASE_URL=postgres://admin_role:changeme@localhost:5432/manage_our_home
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
SMTP_HOST=smtp.eu-provider.example
SMTP_USERNAME=changeme
SMTP_PASSWORD=changeme
SMTP_FROM=Manage Our Home <no-reply@example.com>
# Symmetric key for pgcrypto's pgp_sym_encrypt/decrypt on OAuth refresh
# tokens. Generate with: openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=changeme
# Same, for Messagerie content (dedicated key, isolated from the above).
MESSAGE_ENCRYPTION_KEY=changeme
# Same, for Google Calendar ICS feed URLs (Epic #9, dedicated key).
CALENDAR_FEED_ENCRYPTION_KEY=changeme
SECURE_COOKIES=true
# MinIO (S3-compatible) object storage for event file attachments.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=manage-our-home
MINIO_REGION=us-east-1
