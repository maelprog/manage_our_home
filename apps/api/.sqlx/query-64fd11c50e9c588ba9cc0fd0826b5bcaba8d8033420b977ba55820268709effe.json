  "query": "\n            SELECT s.expires_at, s.revoked_at,\n                   u.id as user_id, u.deleted_at, u.is_superadmin\n            FROM sessions s\n            JOIN users u ON u.id = s.user_id\n            WHERE s.id = $1\n            ",
