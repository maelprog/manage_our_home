  "query": "\n        SELECT t.user_id, t.expires_at, t.consumed_at\n        FROM email_verification_tokens t\n        JOIN users u ON u.id = t.user_id\n        WHERE t.token = $1 AND u.deleted_at IS NULL\n        FOR UPDATE OF t\n        ",
