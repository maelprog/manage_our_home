  "query": "\n            SELECT s.id as session_id, s.expires_at, s.revoked_at,\n                   u.id as user_id, u.email, u.email_verified, u.deleted_at\n            FROM sessions s\n            JOIN users u ON u.id = s.user_id\n            WHERE s.id = $1\n            ",
