  "query": "\n        SELECT g.id, g.name, g.created_at, gm.role as \"role: String\"\n        FROM group_members gm\n        JOIN groups g ON g.id = gm.group_id\n        WHERE gm.user_id = $1\n        ORDER BY g.created_at\n        ",
