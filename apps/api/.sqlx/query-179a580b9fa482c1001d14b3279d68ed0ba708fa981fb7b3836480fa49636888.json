  "query": "\n        SELECT s.id, s.name, o.quantity AS \"pack!\", o.categories_tags\n        FROM stock_items s\n        JOIN off_products o ON o.code = s.barcode\n        WHERE s.group_id = $1 AND o.quantity IS NOT NULL\n        ORDER BY s.id\n        ",
