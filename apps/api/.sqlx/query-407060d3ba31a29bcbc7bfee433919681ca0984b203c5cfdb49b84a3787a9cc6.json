  "query": "\n        UPDATE stock_items SET\n            name = COALESCE($3, name),\n            category = COALESCE($4, category),\n            quantity = $5,\n            unit = COALESCE($6, unit),\n            reorder_threshold = $7,\n            updated_at = now()\n        WHERE id = $1 AND group_id = $2\n        RETURNING id, group_id, created_by, name, category, quantity, unit, reorder_threshold\n        ",
