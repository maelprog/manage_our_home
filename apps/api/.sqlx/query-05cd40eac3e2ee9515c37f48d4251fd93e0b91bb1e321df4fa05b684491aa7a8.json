  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, group_id, created_by, title, description, location, starts_at, ends_at, all_day, is_task, completed_at, rrule, is_private, exdates\n        FROM events\n        WHERE group_id = $1\n          AND starts_at <= $3\n          AND (rrule IS NOT NULL OR ends_at >= $2)\n        ORDER BY starts_at\n        ",
