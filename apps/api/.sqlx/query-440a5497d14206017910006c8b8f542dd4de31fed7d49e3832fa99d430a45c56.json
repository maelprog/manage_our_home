  "query": "\n        SELECT id, storage_key, mime_type, thumbnail_attempts\n        FROM event_attachments\n        WHERE thumbnail_key IS NULL\n          AND thumbnail_attempts < $1\n          AND mime_type = ANY($2)\n          AND id > $3\n        ORDER BY id\n        LIMIT $4\n        ",
