{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT sn.id, sn.occurrence_at, sn.attempts, e.title, u.email\n        FROM scheduled_notifications sn\n        JOIN events e ON e.id = sn.event_id\n        JOIN users u ON u.id = e.created_by\n        WHERE sn.status = 'pending' AND sn.fire_at <= now()\n        ",
