  "query": "\n        SELECT s.expires_at, s.revoked_at, s.last_seen_at, s.restricted,\n               u.deleted_at, u.deactivated_at, u.age_declared_at\n        FROM sessions s\n        JOIN users u ON u.id = s.user_id\n        WHERE s.id = $1\n        ",
