  "query": "\n        SELECT r.id as reminder_id, r.offset_minutes, e.id as event_id, e.starts_at, e.rrule\n        FROM event_reminders r\n        JOIN events e ON e.id = r.event_id\n        WHERE e.rrule IS NOT NULL\n        ",
