  "query": "\n        SELECT sn.id, sn.occurrence_at, sn.attempts, e.title, e.created_by\n        FROM scheduled_notifications sn\n        JOIN events e ON e.id = sn.event_id\n        WHERE sn.status = 'pending' AND sn.fire_at <= now()\n        ",
