  "query": "\n        UPDATE grocery_items SET\n            name = COALESCE($3, name),\n            quantity = $4,\n            unit = $5,\n            updated_at = now()\n        WHERE id = $1 AND group_id = $2\n        RETURNING id, group_id, created_by, name, quantity, unit, checked, source, source_recipe_id, created_at, updated_at\n        ",
