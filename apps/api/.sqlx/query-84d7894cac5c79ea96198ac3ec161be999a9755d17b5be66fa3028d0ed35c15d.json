  "query": "\n        SELECT t.user_id, t.expires_at\n        FROM password_reset_tokens t\n        JOIN users u ON u.id = t.user_id\n        WHERE t.token = $1 AND u.deleted_at IS NULL AND u.deactivated_at IS NULL\n        FOR UPDATE OF t\n        ",
