  "db_name": "PostgreSQL",
  "query": "\n        UPDATE recipes SET\n            name = COALESCE($3, name),\n            instructions = $4,\n            servings = $5,\n            duration_minutes = $6,\n            updated_at = now()\n        WHERE id = $1 AND group_id = $2\n        RETURNING id, group_id, created_by, name, instructions, source_url, servings, duration_minutes, created_at, updated_at\n        ",
