  "query": "SELECT id, group_id, kind, object_id, body, read_at, created_at\n           FROM notifications\n           WHERE user_id = $1\n             AND ($2::text IS NULL OR kind = $2)\n             AND ($3::timestamptz IS NULL OR (created_at, id) < ($3, $4))\n           ORDER BY created_at DESC, id DESC\n           LIMIT $5",
