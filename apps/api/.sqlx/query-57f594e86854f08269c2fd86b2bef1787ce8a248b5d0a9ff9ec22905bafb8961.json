{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, group_id, created_by,\n               pgp_sym_decrypt(content, $4) as \"content!\",\n               edited_at, created_at, updated_at\n        FROM messages\n        WHERE group_id = $1\n          AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3))\n        ORDER BY created_at DESC, id DESC\n        LIMIT $5\n        ",
