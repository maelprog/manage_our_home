  "query": "\n        SELECT i.user_id, u.deleted_at IS NOT NULL OR u.deactivated_at IS NOT NULL AS \"locked!\"\n        FROM oauth_identities i\n        JOIN users u ON u.id = i.user_id\n        WHERE i.provider = 'google' AND i.provider_user_id = $1\n        ",
