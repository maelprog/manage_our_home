  "query": "\n        INSERT INTO messages (group_id, created_by, content)\n        VALUES ($1, $2, pgp_sym_encrypt($3, $4))\n        RETURNING id, group_id, created_by,\n                  pgp_sym_decrypt(content, $4) as \"content!\",\n                  edited_at, created_at, updated_at\n        ",
