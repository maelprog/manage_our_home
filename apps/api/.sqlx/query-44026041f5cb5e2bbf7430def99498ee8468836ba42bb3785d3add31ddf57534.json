  "query": "\n        SELECT id, recipe_id, eaten_on, created_by, created_at\n        FROM meal_history\n        WHERE group_id = $1 AND eaten_on >= CURRENT_DATE - $2::bigint * INTERVAL '1 day'\n        ORDER BY eaten_on DESC\n        ",
