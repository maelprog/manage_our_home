  "query": "\n        SELECT recipe_id, MAX(eaten_on) as \"last_eaten_on!\"\n        FROM meal_history\n        WHERE group_id = $1 AND eaten_on >= $3::date - $2::bigint * INTERVAL '1 day'\n        GROUP BY recipe_id\n        ",
