  "db_name": "PostgreSQL",
  "query": "\n        UPDATE messages SET\n            content = pgp_sym_encrypt($3, $4),\n            edited_at = now(),\n            updated_at = now()\n        WHERE id = $1 AND group_id = $2\n        RETURNING id, group_id, created_by,\n                  pgp_sym_decrypt(content, $4) as \"content!\",\n                  edited_at, created_at, updated_at\n        ",
