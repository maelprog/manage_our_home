  "db_name": "PostgreSQL",
  "query": "\n        SELECT gm.user_id, gm.role as \"role: String\", u.display_name, u.email,\n               (u.avatar_key IS NOT NULL) AS \"has_avatar!\"\n        FROM group_members gm\n        JOIN users u ON u.id = gm.user_id\n        WHERE gm.group_id = $1\n        ",
