  "query": "\n        UPDATE recipe_selections SET\n            servings = COALESCE($3, servings),\n            planned_on = $4,\n            meal_slot = $5,\n            updated_at = now()\n        WHERE recipe_id = $1 AND group_id = $2 AND status = 'planned'\n        RETURNING id, recipe_id, status, servings, planned_on, meal_slot,\n                  created_by, created_at, updated_at\n        ",
