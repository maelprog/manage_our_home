  "query": "SELECT g.id, g.name, gm.role AS \"role: String\", gm.joined_at,\n                  (g.created_by = $1) AS \"created_by_me!\"\n           FROM group_members gm\n           JOIN groups g ON g.id = gm.group_id\n           WHERE gm.user_id = $1\n           ORDER BY g.name",
