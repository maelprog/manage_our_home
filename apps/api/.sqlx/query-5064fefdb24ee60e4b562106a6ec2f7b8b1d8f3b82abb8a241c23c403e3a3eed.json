{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT g.id, g.name, g.created_at, count(gm.user_id) as \"member_count!\"\n        FROM groups g\n        LEFT JOIN group_members gm ON gm.group_id = g.id\n        GROUP BY g.id, g.name, g.created_at\n        ORDER BY g.created_at\n        ",
