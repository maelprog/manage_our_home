<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      allowBackup false: Android's backup would copy the app's data, the
      WebView's cookies among them (the session), to the Google account of
      the phone. From Android 12 it no longer stops the transfer to a new
      phone: dataExtractionRules excludes everything from both
      (res/xml/data_extraction_rules.xml). networkSecurityConfig: system
      authorities only, no plain http (res/xml/network_security_config.xml).
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Where the camera writes the photo of a barcode before the
             WebView hands it to the form (BridgeWebChromeClient). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          The server's pushes by Firebase Cloud Messaging (#1004). The app's
          service shows them, app closed or open (PushMessagingService); the
          Push Notifications plugin's, which it extends, is removed: two
          services on MESSAGING_EVENT, and Firebase would deliver to either.
          Auto-init off: no token is asked of Google at launch, only once
          the page registers the phone (permission granted, member logged
          in: apps/web/src/local-reminders.js). The plugin's register()
          turns it on, its unregister() off again.
        -->
        <service
            android:name=".PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!--
          The cooking timers' alarm (#1017): the end of a timer, and its
          « Arrêter », with no page and the app killed (CookTimers). Not
          exported: only the app's own pending intents reach it.
        -->
        <receiver
            android:name=".CookTimerReceiver"
            android:exported="false" />
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      The photo of a barcode (apps/web/src/routes/stocks/new.rs, an input
      with accept="image/*" and capture="environment"): Capacitor's file
      chooser opens the camera when this permission is declared, and asks
      for it the first time (refused: MainActivity.CameraChromeClient says
      so). The camera is not required to install the app.

      It opens the camera only if
      `new Intent(MediaStore.ACTION_IMAGE_CAPTURE).resolveActivity()` finds
      a camera app, and the file picker (the gallery) otherwise. From
      Android 11 on (targetSdk 30 and up), that lookup sees no other app
      unless the intent is declared in <queries> (#802): without it, the
      field opened the gallery.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
    <!--
      The event reminders scheduled on the phone (#668, the Local
      Notifications plugin, whose own manifest declares them too): showing
      a notification, asked for at run time from Android 13 on
      /account/notifications; and exact alarms, so that a reminder is not
      delayed by battery saving. From Android 14 the member grants them in
      « Alarmes et rappels », and the reminders go on inexact if they do
      not. Not USE_EXACT_ALARM: Android would grant it without asking.
      The same permission shows the server's pushes (#1004).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!--
      The cooking timers (#1017, CookTimers), whose alarms use the two
      permissions above: a timer that ends opens full screen, granted at
      install below Android 14; from it on, Android may refuse it
      (NotificationManager.canUseFullScreenIntent()), and the timer is a
      high-priority notification to touch. The Play Store reserves it to
      alarm and calling apps: publishing there may ask why. VIBRATE: the
      timer's notification vibrates, below Android 8 too.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Declared by the Social Login plugin's own manifest (#670):
      AccountManager's permission, which Android stopped using at API 23,
      below this app's minSdk. The sign-in goes through Credential Manager
      and needs nothing of it: removed from the merged manifest.
    -->
    <uses-permission android:name="android.permission.USE_CREDENTIALS" tools:node="remove" />
</manifest>
