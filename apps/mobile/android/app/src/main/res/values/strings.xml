<?xml version='1.0' encoding='utf-8'?>
<!--
  The app's name is not here: app/build.gradle takes it from the synced
  capacitor.config.json (appName), which capacitor.config.ts takes from
  apps/web/src/brand.rs, the name the web manifest gives.
-->
<resources>
    <string name="package_name">fr.watallo.mhome</string>
    <string name="custom_url_scheme">fr.watallo.mhome</string>
    <!-- The launcher's shortcut to the choice of a site (#738, MainActivity). -->
    <string name="change_site_short">Autre site</string>
    <string name="change_site_long">Changer de site</string>
    <!-- The camera refused to the photo of a barcode (#802, MainActivity.CameraChromeClient). -->
    <string name="camera_refused">L\'appareil photo n\'est pas autorisé. Pour photographier le code, autorisez-le dans les réglages d\'Android, ou tapez les chiffres du code-barres.</string>
</resources>
