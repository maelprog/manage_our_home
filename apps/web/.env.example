# apps/web — server-side-rendered front-end (Leptos SSR + axum).
# Copy to .env and adjust. All three have sensible defaults baked into
# main.rs, so for a plain local run you can skip this file entirely.

# Where the web server reaches apps/api, server-to-server. In docker-compose
# this is the internal service name (http://api:8080); for a local `cargo run`
# it's the API you started by hand.
API_INTERNAL_BASE_URL=http://localhost:8080

# Base URL the *browser* uses for API-hosted links (e.g. the Google OAuth
# start endpoint, which apps/api serves directly). Behind Caddy the API is
# exposed under /api, so in production this is `${PUBLIC_BASE_URL}/api`.
# For a local run pointing straight at the API, use its full URL.
API_PUBLIC_BASE_URL=/api

# Address/port the web server binds to.
WEB_BIND_ADDR=0.0.0.0:3000
